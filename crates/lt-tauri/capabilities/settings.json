{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: configuration, history, diagnostics and the updater",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:default",
    "settings-commands",
    "history-commands"
  ]
}
